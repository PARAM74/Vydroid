{
  "config_version": 1,
  "remote_config": {
    "enabled": true,
    "refresh_interval_seconds": 3600,
    "refresh_on_foreground": true,
    "use_cache": true,
    "network_timeout_seconds": 5
  },
  "platforms": {
    "mobile": {
      "enabled": true
    },
    "android_tv": {
      "enabled": true
    }
  },
  "ads": {
    "home_native": {
      "enabled": true,
      "mobile": {
        "enabled": true,
        "content_interval": 1,
        "max_ads_per_screen": 2
      },
      "android_tv": {
        "enabled": true,
        "content_interval": 2,
        "max_ads_per_screen": 2
      }
    },
    "app_open_rewarded": {
      "enabled": true,
      "mobile": {
        "enabled": true,
        "max_ads_per_session": 1,
        "cooldown_seconds": 3600
      },
      "android_tv": {
        "enabled": true,
        "max_ads_per_session": 1,
        "cooldown_seconds": 1800
      }
    }
  }
}
